#include <iostream>
#include <string>
#include <algorithm>

using namespace std;

void solve() {
    int n;
    cin >> n;
    string s;
    cin >> s;
    
    int cnt0 =0;
    int cnt1 = 0;
    
    for (char c : s) {
        if (c == '0') {
            cnt0++;
        } else {
            cnt1++;
        }
    }
    
    int max_len = min(n, 2 * min(cnt0, cnt1) + 1);
    cout << max_len << "\n";
}

int main() {
    
    int t;
    if (cin >> t) {
        while (t--) {
            solve();
        }
    }
    return 0;
}